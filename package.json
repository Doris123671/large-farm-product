{
  "name": "library-catalog-service",
  "version": "1.0.0",
  "private": true,
  "description": "REST API and Mongoose data layer for a library book catalog.",
  "main": "server.js",
  "scripts": {
    "test": "jest --runInBand && node --test test/rules.test.js",
    "seed": "node seed.js",
    "seed:user": "node seedUser.js",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
